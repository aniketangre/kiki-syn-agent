# ============================================================
# .env.example — copy this file to .env and fill in your keys
# ============================================================
# IMPORTANT: Never commit .env to git. It is listed in .gitignore.
# ============================================================

# --- LangSmith (observability + tracing) ---
# Sign up at: https://smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT="kiki-syn-agent"
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com  (EU accounts only)

# --- Google AI (Gemini) ---
# Get your free key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# --- Groq API ---
# Get your key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenAI API ---
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- KIKI ML API ---
# Local FastAPI server that predicts optimal lattice orientation and cell type
KIKI_API_URL=http://127.0.0.1:8000

# --- Synera headless executable ---
# Full path to syneraheadless.exe if it is not on your system PATH
# Example (Windows): C:\Program Files\Synera\syneraheadless.exe
SYNERA_EXE=syneraheadless.exe

# --- PostgreSQL connection (optional, for production persistence) ---
# Run 'python scripts/db_setup.py' once after setting this.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
POSTGRES_URI=postgresql://postgres:yourpassword@localhost:5432/kiki_agent
